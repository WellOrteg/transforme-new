---
import CarregarTurnstile from './CarregarTurnstile.astro';

const CHAVE_TURNSTILE = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<form method="post" action="/api/newsletter" class="grid gap-3">
  <div>
    <label for="news-email" class="mb-1 block text-sm">E-mail <span aria-hidden="true">*</span></label>
    <input id="news-email" name="email" type="email" required autocomplete="email"
      class="w-full rounded-lg border border-[var(--borda)] bg-transparent px-4 py-2 text-sm" />
  </div>

  <div class="flex items-start gap-2">
    <input id="news-consentimento" name="consentimento" type="checkbox" required class="mt-1" />
    <label for="news-consentimento" class="text-xs text-[var(--texto-suave)]">
      Concordo em receber conteúdos da transforme.tech por e-mail e com a
      <a href="/politica-de-privacidade/" class="underline">política de privacidade</a>.
    </label>
  </div>

  <div class="cf-turnstile" data-sitekey={CHAVE_TURNSTILE}></div>

  <p role="alert" aria-live="polite" data-erro class="text-sm text-[#FF6B6B] empty:hidden"></p>

  <button type="submit" data-acao
    class="justify-self-start rounded-full px-5 py-2 text-sm font-semibold text-[var(--acento-texto)]"
    style="background: var(--acento-superficie)">
    Inscrever-se
  </button>
</form>

<CarregarTurnstile />

<script>
  const form = document.querySelector('form[action="/api/newsletter"]') as HTMLFormElement | null;
  const erro = form?.querySelector('[data-erro]') as HTMLElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!erro) return;
    erro.textContent = '';

    const botao = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    botao.disabled = true;

    try {
      const r = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const dados = (await r.json()) as { ok: boolean; erros?: Record<string, string> };

      if (dados.ok) {
        form.innerHTML =
          '<p class="text-[var(--texto-forte)]">Inscrição confirmada. Obrigado!</p>';
        return;
      }
      erro.textContent = Object.values(dados.erros ?? {}).join(' ');
    } catch {
      erro.textContent = 'Não foi possível enviar agora. Tente novamente em instantes.';
    } finally {
      botao.disabled = false;
    }
  });
</script>
