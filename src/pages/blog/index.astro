---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CardPost from '../../components/blog/CardPost.astro';
import FiltroCategoria from '../../components/blog/FiltroCategoria.astro';

const posts = (await getCollection('blog', ({ data }) => !data.rascunho)).sort(
  (a, b) => b.data.data.valueOf() - a.data.data.valueOf(),
);
---

<Base
  titulo="Conteúdos — transforme.tech"
  descricao="Captação de recursos, gestão e tecnologia para quem transforma realidades."
>
  <section data-tema="escuro" class="relative overflow-clip bg-[var(--superficie)]">
    <div
      class="pointer-events-none absolute -right-48 -top-72 h-[520px] w-[520px]"
      style="background: radial-gradient(circle, rgb(140 115 255 / 0.45) 0%, rgb(140 115 255 / 0) 62%)"
      aria-hidden="true"
    ></div>
    <div class="relative mx-auto max-w-6xl px-6 py-10 md:py-16">
      <h1 data-entra style="--i:0" class="text-[clamp(2.25rem,5vw,3.5rem)] text-[var(--texto-forte)]">Conteúdos</h1>
      <p data-entra style="--i:1" class="mt-3 max-w-md text-[var(--texto-suave)]">
        Captação de recursos, gestão e tecnologia para quem transforma realidades.
      </p>
      <div data-entra style="--i:2" class="mt-8"><FiltroCategoria /></div>
    </div>
  </section>

  <div data-revela-grupo class="mx-auto grid max-w-6xl gap-10 px-6 py-10 md:py-16 md:grid-cols-3">
    {posts.map((post) => <CardPost post={post} />)}
  </div>
</Base>
