---
import CarregarTurnstile from './CarregarTurnstile.astro';
import { EBOOK_URL } from '../../dados/ebook';
import type { OrigemContato } from '../../dados/origens';

// `origem` separa no painel de leads e no e-mail do comercial de qual página
// veio o contato (ver src/dados/origens.ts). O e-book tem API própria, que já
// grava a origem dele.
interface Props { ebook?: boolean; origem?: OrigemContato }
const { ebook = false, origem = 'contato' } = Astro.props;

const CHAVE_TURNSTILE = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

// O §15 do roteiro do cliente lista seis desafios. Eles entram como sugestão de
// um campo de texto, não como lista fechada: quem se reconhece numa delas
// escolhe em um toque, e quem tem outro problema descreve o próprio. Sem
// JavaScript, o datalist é ignorado e sobra um campo de texto comum.
const desafios = [
  'Captação de recursos',
  'Gestão financeira',
  'Relacionamento/CRM',
  'Gestão de projetos/impacto',
  'Eventos/cursos',
  'Outro',
];
---

<form method="post" action={ebook ? '/api/ebook' : '/api/contato'} data-form-contato data-ebook={ebook ? 'true' : undefined} class="grid gap-4">
  {ebook ? <input type="hidden" name="parceiro" value="" /> : <input type="hidden" name="origem" value={origem} />}
  <div>
    <label for="contato-nome" class="mb-1 block text-sm">Nome <span aria-hidden="true">*</span></label>
    <input id="contato-nome" name="nome" type="text" required autocomplete="name"
      class="w-full rounded-lg border border-[var(--borda)] bg-transparent px-4 py-3" />
  </div>

  <div>
    <label for="contato-organizacao" class="mb-1 block text-sm">Organização <span aria-hidden="true">*</span></label>
    <input id="contato-organizacao" name="organizacao" type="text" required autocomplete="organization"
      class="w-full rounded-lg border border-[var(--borda)] bg-transparent px-4 py-3" />
  </div>

  <div>
    <label for="contato-whatsapp" class="mb-1 block text-sm">WhatsApp <span aria-hidden="true">*</span></label>
    <input id="contato-whatsapp" name="whatsapp" type="tel" required autocomplete="tel"
      class="w-full rounded-lg border border-[var(--borda)] bg-transparent px-4 py-3" />
  </div>

  <div>
    <label for="contato-email" class="mb-1 block text-sm">E-mail <span aria-hidden="true">*</span></label>
    <input id="contato-email" name="email" type="email" required autocomplete="email"
      class="w-full rounded-lg border border-[var(--borda)] bg-transparent px-4 py-3" />
  </div>

  <div>
    <label for="contato-desafio" class="mb-1 block text-sm">
      Qual o principal desafio da sua organização?
    </label>
    <input id="contato-desafio" name="desafio" type="text" list="desafios-organizacao" maxlength="200"
      class="w-full rounded-lg border border-[var(--borda)] bg-transparent px-4 py-3" />
    <datalist id="desafios-organizacao">
      {desafios.map((d) => <option value={d}></option>)}
    </datalist>
  </div>

  <div class="cf-turnstile" data-sitekey={CHAVE_TURNSTILE}></div>

  <p role="alert" aria-live="polite" data-erro class="text-sm text-[#C0392B] empty:hidden"></p>

  <button type="submit" data-acao
    class="justify-self-start rounded-full px-6 py-3 text-sm font-semibold text-[var(--acento-texto)]"
    style="background: var(--acento-superficie)">
    {ebook ? 'Enviar e receber e-book' : 'Enviar formulário'}
  </button>

  <p class="text-xs text-[var(--texto-suave)]">
    Ao enviar, você concorda com a nossa{' '}
    <a href="/politica-de-privacidade/" class="underline">política de privacidade</a>.
  </p>
</form>

{ebook && (
  <dialog data-ebook-dialog aria-labelledby="ebook-dialog-titulo" class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-[var(--borda)] bg-[var(--superficie)] p-8 text-[var(--texto-forte)] shadow-xl backdrop:bg-black/60">
    <h2 id="ebook-dialog-titulo" class="text-2xl">Baixe seu ebook aqui</h2>
    <p class="mt-4 text-[var(--texto-suave)]">Também enviamos o link para o seu e-mail. Você pode baixar o PDF agora:</p>
    <a href={EBOOK_URL} download class="mt-6 inline-flex rounded-full bg-[var(--acento-superficie)] px-6 py-3 font-semibold text-[var(--acento-texto)]">Baixar e-book</a>
    <button type="button" data-fechar-ebook class="mt-6 block text-sm underline">Fechar</button>
  </dialog>
)}

<CarregarTurnstile />

<script>
  const form = document.querySelector('[data-form-contato]') as HTMLFormElement | null;
  const erro = form?.querySelector('[data-erro]') as HTMLElement | null;
  const parceiro = form?.querySelector<HTMLInputElement>('[name="parceiro"]');
  if (parceiro) parceiro.value = new URLSearchParams(window.location.search).get('parceiro')?.trim().toLowerCase() ?? '';
  const dialog = document.querySelector<HTMLDialogElement>('[data-ebook-dialog]');
  document.querySelector('[data-fechar-ebook]')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('close', () => form?.querySelector<HTMLButtonElement>('button[type="submit"]')?.focus());
  let ebookEnviado = false;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (ebookEnviado) { dialog?.showModal(); return; }
    if (!erro) return;
    erro.textContent = '';

    const botao = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    botao.disabled = true;

    try {
      const r = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const dados = (await r.json()) as { ok: boolean; erros?: Record<string, string> };

      if (r.ok && dados.ok) {
        if (form.dataset.ebook === 'true') {
          ebookEnviado = true;
          botao.textContent = 'Baixar e-book';
          dialog?.showModal();
          return;
        }
        form.innerHTML =
          '<p class="text-[var(--texto-forte)]">Mensagem enviada. Retornamos em breve.</p>';
        return;
      }
      erro.textContent = Object.values(dados.erros ?? {}).join(' ') || 'Não foi possível enviar agora. Tente novamente em instantes.';
    } catch {
      erro.textContent = 'Não foi possível enviar agora. Tente novamente em instantes.';
    } finally {
      botao.disabled = false;
      if (form.dataset.ebook === 'true' && !ebookEnviado) {
        const turnstile = (window as unknown as { turnstile?: { reset: (widget: HTMLElement) => void } }).turnstile;
        const widget = form.querySelector<HTMLElement>('.cf-turnstile');
        if (widget && turnstile) turnstile.reset(widget);
      }
    }
  });
</script>
