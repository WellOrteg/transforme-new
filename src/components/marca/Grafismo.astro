---
interface Props {
  class?: string;
  opacidade?: number;
  /** Desenha os arcos traço a traço na entrada da página, em vez de já estarem lá. */
  desenhar?: boolean;
}
const { class: classe, opacidade = 0.13, desenhar = false } = Astro.props;
---

<svg
  viewBox="0 0 335.25 389"
  fill="none"
  stroke="currentColor"
  data-desenha={desenhar ? '' : undefined}
  class:list={['pointer-events-none absolute', classe]}
  style={`opacity:${opacidade}`}
  aria-hidden="true"
>
  <path d="M 140.75 18.25 A 176.25 176.25 0 0 1 140.75 370.75" stroke-width="36.5"></path>
  <path d="M 140.75 317.5 A 123 123 0 0 1 140.75 71.5" stroke-width="35.5"></path>
</svg>
