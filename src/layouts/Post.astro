---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from './Base.astro';
import CapaGerada from '../components/blog/CapaGerada.astro';
import Sumario from '../components/post/Sumario.astro';
import BarraProgresso from '../components/post/BarraProgresso.astro';
import Compartilhar from '../components/post/Compartilhar.astro';
import { tempoLeitura } from '../lib/tempoLeitura';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: { depth: number; slug: string; text: string }[];
  corpo: string;
}
const { post, headings, corpo } = Astro.props;
const { titulo, resumo, data, autor, categoria, capa, capaAlt } = post.data;

const url = new URL(`/blog/${post.id}/`, Astro.site).href;
const minutos = tempoLeitura(corpo);
const dataLonga = data.toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' });

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: titulo,
  description: resumo,
  datePublished: data.toISOString(),
  author: { '@type': 'Person', name: autor },
  publisher: { '@type': 'Organization', name: 'transforme.tech' },
  mainEntityOfPage: url,
};
---

<Base titulo={`${titulo} — transforme.tech`} descricao={resumo} tipo="article">
  <BarraProgresso />

  <header data-tema="escuro" class="relative overflow-clip bg-[var(--superficie)] px-6 pb-16 pt-8 md:pb-24 md:pt-12">
    <div
      class="pointer-events-none absolute -right-40 -top-64 h-[480px] w-[480px]"
      style="background: radial-gradient(circle, rgb(140 115 255 / 0.45) 0%, rgb(140 115 255 / 0) 62%)"
      aria-hidden="true"
    ></div>
    <div class="relative mx-auto max-w-2xl">
      <p class="mb-3 text-[10px] font-semibold uppercase tracking-[0.15em] text-[var(--acento)]">
        {categoria}
      </p>
      <h1 class="text-[clamp(1.9rem,4.5vw,3rem)] text-[var(--texto-forte)]">{titulo}</h1>
      <p class="mt-4 text-sm text-[var(--texto-suave)]">
        {autor} · <time datetime={data.toISOString()}>{dataLonga}</time> · {minutos} min de leitura
      </p>
    </div>
  </header>

  <div class="relative z-10 mx-auto -mt-16 max-w-2xl px-6">
    {capa ? (
      <Image src={capa} alt={capaAlt!} width={960} height={480} class="w-full rounded-2xl object-cover shadow-2xl" />
    ) : (
      <CapaGerada categoria={categoria} class="h-44 w-full rounded-2xl shadow-2xl" />
    )}
  </div>

  <div class="mx-auto grid max-w-4xl gap-10 px-6 py-12 md:grid-cols-[168px_1fr]">
    <aside class="md:sticky md:top-16 md:self-start">
      <div class="hidden md:block"><Sumario headings={headings} idPrefix="desktop-" /></div>
      <details class="mb-6 rounded-xl border border-[var(--borda)] p-3 md:hidden">
        <summary class="cursor-pointer list-none text-sm font-semibold">Neste artigo</summary>
        <div class="mt-3"><Sumario headings={headings} idPrefix="mobile-" /></div>
      </details>
      <div class="mt-8 hidden md:block"><Compartilhar url={url} titulo={titulo} /></div>
    </aside>

    <article class="prose">
      <slot />
      <div class="mt-8 md:mt-12 md:hidden"><Compartilhar url={url} titulo={titulo} /></div>
    </article>
  </div>
</Base>

<script type="application/ld+json" set:html={JSON.stringify(jsonld)} is:inline />
