---
import Grafismo from '../marca/Grafismo.astro';
import MockupPlataforma from './MockupPlataforma.astro';
import IconeRede from '../layout/IconeRede.astro';
import { linkWhatsApp } from '../../dados/contato';

// O §2 do roteiro do cliente, com os textos que o dono reescreveu em 09/09/2026
// (documento "alterações para o novo site", item 14): o tempo de estrada passou
// para o título e a promessa do produto para a linha de baixo.
//
// Saiu junto o parágrafo "Há 10 anos ajudando organizações...", que repetia os
// dez anos três linhas abaixo do título novo.
//
// O WhatsApp é o botão preenchido: o roteiro o desenha como link e escreve que
// ele é o CTA principal — seguimos o que ele escreve. O símbolo do aplicativo
// vem junto do rótulo: quem reconhece o desenho sabe que o clique abre uma
// conversa, não um formulário.
//
// Em 08/09/2026 o dono tirou daqui o "Com a transforme.tech você consegue:"
// com as nove frases que se alternavam (elas vinham do topo do site antigo) e
// também o link secundário "Conhecer a transforme.tech". O hero fica com uma
// saída só: a conversa.
---

<section data-tema="escuro" class="relative overflow-clip bg-[var(--superficie)]">
  {/* O brilho fica do lado do texto. À direita ele passaria por baixo do vídeo do
      mockup, que é um retângulo navy opaco, e a caixa apareceria recortada nele. */}
  <div
    class="pointer-events-none absolute -left-56 -top-64 h-[600px] w-[600px]"
    style="background: radial-gradient(circle, rgb(140 115 255 / 0.45) 0%, rgb(140 115 255 / 0) 62%)"
    aria-hidden="true"
  ></div>
  <Grafismo class="-left-24 bottom-[-180px] w-[340px] text-[var(--color-roxo-400)]" opacidade={0.1} desenhar />

  <div class="relative mx-auto grid max-w-6xl gap-10 px-6 md:gap-12 pb-16 pt-8 md:pb-24 md:pt-12 md:grid-cols-[1.15fr_1fr] md:items-center">
    <div>
      <h1 data-entra style="--i:0" class="max-w-2xl text-[clamp(2rem,3.6vw,3.25rem)] text-[var(--texto-forte)]">
        + de 10 anos potencializando o impacto e a missão através da tecnologia.
      </h1>

      <p data-entra style="--i:1" class="mt-6 max-w-xl text-lg text-[var(--texto-suave)]">
        Organize sua gestão, fortaleça suas doações online, receba suas inscrições online e
        acompanhe o impacto da sua organização em um só lugar.
      </p>

      <div data-entra style="--i:2" class="mt-8">
        <a
          href={linkWhatsApp()}
          data-acao
          class="inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-semibold text-[var(--acento-texto)]"
          style="background: var(--acento-superficie)"
        >
          <IconeRede id="whatsapp" class="h-5 w-5 shrink-0" />
          Falar com um especialista no WhatsApp
        </a>
      </div>
    </div>

    <div data-entra style="--i:3">
      <MockupPlataforma />
    </div>
  </div>
</section>
