---
import { Image } from 'astro:assets';
import capa from '../../assets/site/video-apresentacao-capa.jpg';

// O mesmo vídeo que abre o "O que fazemos?" do site atual.
//
// Não é um <iframe> do YouTube: o player dele passa de 600 KB de JavaScript e
// sozinho estouraria o orçamento medido em tests/e2e/desempenho.spec.ts. Aqui
// fica a capa (auto-hospedada, para nem o ytimg.com ser chamado) dentro de um
// link para o vídeo. Quem tem JavaScript vê o player nascer no lugar do link,
// na versão sem cookies; quem não tem, vai para o YouTube pelo link.
const ID = 'cDZmDhgqD2E';
const TITULO = 'Por que ser parceiro da transforme.tech? Conheça nossas soluções!';
---

<figure class="m-0">
  <div
    data-video
    class="relative aspect-video overflow-clip rounded-2xl border border-[var(--borda)] bg-[var(--color-navy-900)]"
  >
    <a
      href={`https://www.youtube.com/watch?v=${ID}`}
      data-id={ID}
      data-titulo={TITULO}
      class="group block h-full w-full"
    >
      <Image
        src={capa}
        alt=""
        width={720}
        height={405}
        loading="lazy"
        class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]"
      />

      {/* O rótulo do link mora aqui: o texto visível é só o triângulo. */}
      <span class="sr-only">Assistir ao vídeo: {TITULO}</span>

      <span
        aria-hidden="true"
        class="absolute inset-0 grid place-items-center bg-[var(--color-navy-900)]/25 transition group-hover:bg-[var(--color-navy-900)]/10"
      >
        <span
          class="grid h-16 w-16 place-items-center rounded-full text-white shadow-lg transition group-hover:scale-110"
          style="background: var(--color-roxo-600)"
        >
          <svg width="20" height="22" viewBox="0 0 20 22" fill="currentColor">
            <path d="M19 9.27a2 2 0 0 1 0 3.46L3 21.99a2 2 0 0 1-3-1.73V1.74A2 2 0 0 1 3 .01l16 9.26Z" />
          </svg>
        </span>
      </span>
    </a>
  </div>

  <figcaption class="mt-3 text-sm text-[var(--texto-suave)]">{TITULO}</figcaption>
</figure>

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-video] a[data-id]')) {
    link.addEventListener('click', (evento) => {
      evento.preventDefault();

      const player = document.createElement('iframe');
      player.src = `https://www.youtube-nocookie.com/embed/${link.dataset.id}?autoplay=1&rel=0`;
      player.title = link.dataset.titulo ?? '';
      player.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      player.allowFullscreen = true;
      player.className = 'absolute inset-0 h-full w-full border-0';
      link.replaceWith(player);
      player.focus();
    });
  }
</script>
