---
// Os desenhos ficam aqui, e não em `dados/solucoes.ts`, para o arquivo de texto
// seguir legível para quem só quer mexer na copy.
//
// O roteiro usa emoji nos títulos das áreas. Emoji renderiza diferente em cada
// sistema, não herda a cor de acento e não escala com a tipografia — daí estes
// cinco traços, no mesmo peso do resto da interface.
interface Props {
  id: string;
  class?: string;
}
const { id, class: classe } = Astro.props;

const desenhos: Record<string, string> = {
  captacao: 'M12 20s-7-4.35-7-9a4 4 0 0 1 7-2.65A4 4 0 0 1 19 11c0 4.65-7 9-7 9Z',
  financeiro: 'M3 21h18M6 21V11M11 21V6M16 21v-8M21 21v-4',
  crm: 'M21 12a8 8 0 0 1-11.6 7.1L3 21l1.9-6.4A8 8 0 1 1 21 12Z',
  impacto: 'M12 21v-8M12 13c0-3.3 2.7-6 6-6 0 3.3-2.7 6-6 6ZM12 13c0-2.8-2.2-5-5-5 0 2.8 2.2 5 5 5Z',
  eventos: 'M3 6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2ZM3 10h18M8 3v4M16 3v4',
};
---

<svg
  class={classe}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={desenhos[id]} />
</svg>
