---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import CapaGerada from './CapaGerada.astro';
import { tempoLeitura } from '../../lib/tempoLeitura';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;

const data = post.data.data.toLocaleDateString('pt-BR', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

const minutos = tempoLeitura(post.body ?? '');
---

<article data-post data-cartao data-categoria={post.data.categoria} class="rounded-xl">
  <a href={`/blog/${post.id}/`} class="group block" data-capa>
    {
      post.data.capa ? (
        <Image
          src={post.data.capa}
          alt={post.data.capaAlt!}
          width={480}
          height={270}
          loading="lazy"
          class="h-40 w-full rounded-xl object-cover"
        />
      ) : (
        <CapaGerada categoria={post.data.categoria} class="h-40 w-full rounded-xl" />
      )
    }

    <p class="mt-4 text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--acento)]">
      {post.data.categoria}
    </p>
    <h2 class="mt-2 text-xl text-[var(--texto-forte)] group-hover:underline">
      {post.data.titulo}
    </h2>
    <p class="mt-2 text-sm text-[var(--texto-suave)]">{post.data.resumo}</p>
    <p class="mt-3 text-xs text-[var(--texto-suave)]">
      <time datetime={post.data.data.toISOString()}>{data}</time> · {post.data.autor} · {minutos} min de leitura
    </p>
  </a>
</article>
