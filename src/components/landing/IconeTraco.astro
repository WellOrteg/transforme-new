---
// Ícones de traço das landing pages (e-book, eventos), no lugar dos ícones de
// fonte que o Elementor usava. Decorativos: o texto ao lado já diz tudo.
const CAMINHOS = {
  confere: 'M20 6 9 17l-5-5',
  balao: 'M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z',
  doacao: 'M12 3v8m-3-6.5h4.5a1.75 1.75 0 0 1 0 3.5h-3a1.75 1.75 0 0 0 0 3.5H15M3 16h3l4 3h6a2 2 0 0 0 0-4h-3m-7 6V14',
  pessoas: 'M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm-6 9a6 6 0 0 1 12 0m1-9a3 3 0 1 0 0-6m2 15h3a5 5 0 0 0-4-4.9',
  grafico: 'M4 20h16M7 16v-5m5 5V7m5 9v-3',
  ia: 'M12 4v16M8.5 4.5A3 3 0 0 0 5 7.5a3 3 0 0 0-1 5 3 3 0 0 0 2 4.5 3 3 0 0 0 5 1.5m1.5-14A3 3 0 0 1 19 7.5a3 3 0 0 1 1 5 3 3 0 0 1-2 4.5 3 3 0 0 1-5 1.5',
  celular: 'M8 3h8a1.5 1.5 0 0 1 1.5 1.5v15A1.5 1.5 0 0 1 16 21H8a1.5 1.5 0 0 1-1.5-1.5v-15A1.5 1.5 0 0 1 8 3Zm3 15h2',
  prancheta: 'M9 4h6v3H9zM9 5.5H6.5A1.5 1.5 0 0 0 5 7v12.5A1.5 1.5 0 0 0 6.5 21h11a1.5 1.5 0 0 0 1.5-1.5V7a1.5 1.5 0 0 0-1.5-1.5H15M9 12h6m-6 4h4',
} as const;

export type NomeIcone = keyof typeof CAMINHOS;

interface Props { nome: NomeIcone; class?: string }
const { nome, class: classe } = Astro.props;
---

<span class:list={['grid h-12 w-12 shrink-0 place-items-center rounded-full border border-[var(--borda)] text-[var(--acento)]', classe]}>
  <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <path d={CAMINHOS[nome]} />
  </svg>
</span>
