---
import Base from './Base.astro';
import Sumario from '../components/post/Sumario.astro';

interface Props {
  titulo: string;
  descricao: string;
  headings?: { depth: number; slug: string; text: string }[];
}
const { titulo, descricao, headings = [] } = Astro.props;
const comSumario = headings.length > 3;
---

<Base titulo={`${titulo} — transforme.tech`} descricao={descricao}>
  <header data-tema="escuro" class="bg-[var(--superficie)] px-6 py-12">
    <div class="mx-auto max-w-3xl">
      <h1 class="text-[clamp(1.9rem,4vw,2.75rem)] text-[var(--texto-forte)]">{titulo}</h1>
    </div>
  </header>

  <div class:list={['mx-auto max-w-4xl gap-10 px-6 py-14', comSumario ? 'grid md:grid-cols-[168px_1fr]' : '']}>
    {comSumario && (
      <aside class="hidden md:sticky md:top-16 md:block md:self-start">
        <Sumario headings={headings} titulo="Nesta página" />
      </aside>
    )}
    <article class="prose"><slot /></article>
  </div>
</Base>
