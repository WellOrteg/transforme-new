---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página não encontrada — transforme.tech" descricao="A página que você procura não existe." naoIndexar>
  <section class="mx-auto max-w-2xl px-6 py-32 text-center">
    <h1 class="text-4xl">Essa página não existe.</h1>
    <p class="mt-4 text-[var(--texto-suave)]">
      O endereço pode ter mudado. Nossos conteúdos continuam no blog.
    </p>
    <p class="mt-8 flex justify-center gap-4">
      <a href="/" class="rounded-full bg-[var(--acento-superficie)] px-6 py-3 text-sm text-[var(--acento-texto)]">
        Voltar ao início
      </a>
      <a href="/blog/" class="px-6 py-3 text-sm text-[var(--acento)]">Ver o blog</a>
    </p>
  </section>
</Base>
